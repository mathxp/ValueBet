# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Para entrar desde el celular por la red local, agregá la IP de tu PC acá
# (ej. 192.168.1.8) -- ver README sección "Acceso desde el celular".
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Secreto compartido con la Pages Function de Cloudflare (mismo valor en ambos lados).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
PROXY_SECRET=

# --- Base de datos (Postgres; usar DATABASE_ENGINE=sqlite para dev rápido) ---
DATABASE_ENGINE=postgresql
POSTGRES_DB=sports_bot
POSTGRES_USER=sports_bot
POSTGRES_PASSWORD=sports_bot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- api-football.com (versión gratuita) ---
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_RATE_LIMIT_PER_MINUTE=10
# Formato "league_id,league_id" — 265 = Primera División de Chile (confirmado en api-football)
WATCHED_LEAGUES=265

# --- Betfair Exchange (dejar vacío hasta tener cuenta/credenciales) ---
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_CERT_PATH=

# --- Gestión de riesgo ---
# PAPER_BANKROLL: tu plata real disponible en la casa/exchange, para que el
# stake sugerido tenga sentido con tu billetera real (no un monto inventado).
PAPER_BANKROLL=5000
KELLY_FRACTION=0.25
MAX_STAKE_PER_BET=500.0
MIN_EDGE_THRESHOLD=0.05
